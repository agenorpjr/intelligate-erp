# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/intelligate?sslmode=disable

# Application
APP_ENV=development
APP_PORT=8080
APP_VERSION=0.1.0

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=24h

# HTTP
HTTP_TIMEOUT=30s

# Encryption (AES-256-GCM)
# Generate with: go run -mod=mod github.com/intelligate/erp/backend/pkg/crypto@latest
# Or use: openssl rand -base64 32
# INTELLIGATE_ENCRYPTION_KEY=base64_encoded_32_byte_key
INTELLIGATE_ENCRYPTION_KEY=