# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/intelligate?sslmode=disable

# Application
APP_ENV=development
APP_PORT=8080
APP_VERSION=0.1.0

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=24h

# HTTP
HTTP_TIMEOUT=30s

# Encryption (AES-256-GCM)
# Generate with: go run -mod=mod github.com/intelligate/erp/backend/pkg/crypto@latest
# Or use: openssl rand -base64 32
# INTELLIGATE_ENCRYPTION_KEY=base64_encoded_32_byte_key
INTELLIGATE_ENCRYPTION_KEY=

# AI Provider (Etapa 13) - Agente de análise gerencial
# Provider: openai | anthropic | mock (mock não faz chamada externa)
INTELLIGATE_AI_PROVIDER=mock
# Nunca commitar a API key real. Deixe vazio para usar o provider mock.
INTELLIGATE_AI_API_KEY=
# Modelo do provedor (ex.: gpt-4o-mini, claude-3-5-sonnet-latest)
INTELLIGATE_AI_MODEL=
# Base URL opcional (para gateways/proxies compatíveis com OpenAI)
INTELLIGATE_AI_BASE_URL=